<Window x:Class="TRIO2026.DevLauncher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRIOV2 — 機台面板物理尺寸與解析度模擬器"
        WindowStartupLocation="CenterScreen"
        Background="#121824"
        MinWidth="820" MinHeight="580"
        ResizeMode="CanMinimize"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 上方控制工具列 (三行配置) -->
        <Border Grid.Row="0" Background="#1E2638" Padding="14,10" BorderBrush="#2A354D" BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- 第一行：目標面板解析度、目標 App 與 啟動/停止 控制 -->
                <DockPanel Margin="0,0,0,8">
                    <!-- 右側操作按鈕 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BrowseButton" Content="📁 選擇 App..." Click="BrowseApp_Click"
                                Width="105" Height="32" FontSize="12" FontWeight="Medium"
                                Foreground="#E0E6ED" Background="#2C384E" BorderThickness="1" BorderBrush="#3D4D6B" Cursor="Hand"
                                Margin="0,0,8,0" ToolTip="選擇要啟動的 TRIOV2.App.exe 檔案位置" />
                        <Button x:Name="RunButton" Content="▶ 啟動 App" Click="Run_Click"
                                Width="100" Height="32" FontSize="13" FontWeight="Bold"
                                Foreground="White" Background="#2E7D32" BorderThickness="0" Cursor="Hand"
                                Margin="0,0,8,0" />
                        <Button x:Name="StopButton" Content="■ 停止" Click="Stop_Click"
                                Width="80" Height="32" FontSize="13" FontWeight="Bold"
                                Foreground="White" Background="#C62828" BorderThickness="0" Cursor="Hand"
                                IsEnabled="False" />
                    </StackPanel>

                    <!-- 左側解析度與預設集 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📐 目標面板解析度:" Foreground="#B0BEC5" FontSize="13" FontWeight="Medium"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="ResolutionCombo" Width="250" Height="32" FontSize="12"
                                  SelectionChanged="Resolution_Changed" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="1920 × 1080 — Full HD 橫式 (預設)" Tag="1920,1080" IsSelected="True" />
                            <ComboBoxItem Content="1280 × 800 — 10.1吋 WXGA 橫式" Tag="1280,800" />
                            <ComboBoxItem Content="1024 × 768 — 4:3 觸控面板" Tag="1024,768" />
                            <ComboBoxItem Content="600 × 960 — TRIO2026 直式" Tag="600,960" />
                            <ComboBoxItem Content="1080 × 1920 — Full HD 直式" Tag="1080,1920" />
                        </ComboBox>

                        <TextBlock Text="模擬縮放率:" Foreground="#78909C" FontSize="12"
                                   VerticalAlignment="Center" Margin="16,0,6,0" />
                        <TextBlock x:Name="ScaleText" Text="100%" Foreground="#64B5F6" FontSize="14"
                                   FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- 第二行：目標面板物理吋數/尺寸 (Physical Panel Dimensions) -->
                <DockPanel Margin="0,0,0,8">
                    <!-- 右側 1:1 勾選與截圖按鈕 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="Real1To1Check" Content="🔍 1:1 實物物理尺寸" Foreground="#64B5F6" FontSize="13" FontWeight="SemiBold"
                                  VerticalAlignment="Center" Margin="0,0,12,0" Checked="Real1To1_Changed" Unchecked="Real1To1_Changed"
                                  ToolTip="勾選後將在開發者螢幕上繪製出「毫米級 100% 真實物理大小」的面板" />
                        <Button x:Name="ScreenshotButton" Content="📷 截圖" Click="Screenshot_Click"
                                Width="75" Height="28" FontSize="12"
                                Foreground="White" Background="#455A64" BorderThickness="0" Cursor="Hand"
                                ToolTip="截圖存至 Screenshots 資料夾" />
                    </StackPanel>

                    <!-- 物理面板吋數與長寬輸入 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖥️ 目標面板規格:" Foreground="#B0BEC5" FontSize="13" FontWeight="Medium"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />

                        <TextBlock Text="吋數:" Foreground="#90A4AE" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="InchCombo" Width="125" Height="28" FontSize="12" VerticalContentAlignment="Center"
                                  SelectionChanged="InchCombo_Changed" Margin="0,0,12,0">
                            <ComboBoxItem Content="15.6 吋 (預設)" Tag="15.6" IsSelected="True" />
                            <ComboBoxItem Content="21.5 吋" Tag="21.5" />
                            <ComboBoxItem Content="27.0 吋" Tag="27.0" />
                            <ComboBoxItem Content="10.1 吋 (21.8 × 13.7 cm)" Tag="10.1" />
                            <ComboBoxItem Content="7.0 吋" Tag="7.0" />
                            <ComboBoxItem Content="自訂長寬" Tag="custom" />
                        </ComboBox>

                        <TextBlock Text="物理寬" Foreground="#78909C" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="PanelWidthBox" Text="34.5" Width="50" Height="28" FontSize="12"
                                 Foreground="White" Background="#263347" BorderBrush="#3D506E"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 TextChanged="PanelSize_Changed" />
                        <TextBlock Text="cm" Foreground="#607D8B" FontSize="11" VerticalAlignment="Center" Margin="2,0,6,0" />

                        <TextBlock Text="×" Foreground="#78909C" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />

                        <TextBlock Text="高" Foreground="#78909C" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="PanelHeightBox" Text="19.4" Width="50" Height="28" FontSize="12"
                                 Foreground="White" Background="#263347" BorderBrush="#3D506E"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 TextChanged="PanelSize_Changed" />
                        <TextBlock Text="cm" Foreground="#607D8B" FontSize="11" VerticalAlignment="Center" Margin="2,0,8,0" />

                        <Button Content="套用面板" Click="ApplySize_Click"
                                Padding="8,0" Height="28" FontSize="12"
                                Foreground="White" Background="#37474F" BorderThickness="0" Cursor="Hand" />
                    </StackPanel>
                </DockPanel>

                <!-- 第三行：當前開發機螢幕 Profile (Current Monitor Calibration for 1:1 Scale) -->
                <Border Background="#161D2B" Padding="8,6" CornerRadius="4" BorderBrush="#263347" BorderThickness="1">
                    <DockPanel>
                        <!-- 右側重置與套用按鈕 -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⚡ 套用螢幕設定" Click="ApplyDevMonitor_Click"
                                    Height="26" Padding="10,0" FontSize="11" FontWeight="Bold"
                                    Foreground="#81D4FA" Background="#1E3A5F" BorderThickness="1" BorderBrush="#29B6F6" Cursor="Hand" Margin="0,0,6,0" />
                            <Button Content="🔄 自動偵測" Click="AutoDetectDevMonitor_Click"
                                    Height="26" Padding="8,0" FontSize="11"
                                    Foreground="#B0BEC5" Background="#263238" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>

                        <!-- 當前螢幕吋數與解析度設定 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💻 當前開發機螢幕校準:" Foreground="#FFB74D" FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="用於計算勾選 1:1 實物物理尺寸時的精準像素毫米對齊比例" />

                            <TextBlock Text="螢幕吋數:" Foreground="#B0BEC5" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="DevMonitorInchBox" Text="27.0" Width="48" Height="26" FontSize="12"
                                     Foreground="#FFF" Background="#263347" BorderBrush="#3D506E"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,12,0"/>

                            <TextBlock Text="解析度:" Foreground="#B0BEC5" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="DevMonitorResWBox" Text="2560" Width="55" Height="26" FontSize="12"
                                     Foreground="#FFF" Background="#263347" BorderBrush="#3D506E"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <TextBlock Text="×" Foreground="#78909C" FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                            <TextBox x:Name="DevMonitorResHBox" Text="1440" Width="55" Height="26" FontSize="12"
                                     Foreground="#FFF" Background="#263347" BorderBrush="#3D506E"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,12,0"/>

                            <TextBlock x:Name="DevPpiText" Text="計算 PPI: 108.8" Foreground="#81D4FA" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 模擬螢幕展現區域 (Display Area) -->
        <Border Grid.Row="1" Background="#0A0E17" Padding="12">
            <Border x:Name="ScreenContainer"
                    Background="#111827"
                    BorderBrush="#374151"
                    BorderThickness="2"
                    CornerRadius="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <!-- 未啟動時的指示與預覽資訊卡 -->
                    <Grid x:Name="PlaceholderGrid" Margin="24">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="80" Height="80" CornerRadius="40" Background="#1E293B" Margin="0,0,0,16">
                                <TextBlock Text="🖥️" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="TRIOV2 機台面板物理模擬器" FontSize="20" FontWeight="Bold"
                                       Foreground="#ECEFF1" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock x:Name="SimResText" Text="模擬解析度: 1920 × 1080 | 面板: 15.6 吋 (34.5 × 19.4 cm)"
                                       FontSize="14" Foreground="#90A4AE" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <Border Background="#1E293B" Padding="12,8" CornerRadius="6" Margin="0,0,0,16">
                                <TextBlock x:Name="AppPathText" Text="目標 App: 未找到 TRIOV2.App.exe" FontSize="12" Foreground="#81D4FA" HorizontalAlignment="Center" />
                            </Border>
                            <Button Content="▶ 啟動 TRIOV2.App" Click="Run_Click"
                                    Padding="24,10" FontSize="15" FontWeight="Bold" Foreground="White" Background="#2E7D32" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                    </Grid>

                    <!-- 嵌入子視窗的 Win32 容器 -->
                    <WindowsFormsHost x:Name="WfHost" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Border>

        <!-- 底部狀態列 -->
        <Border Grid.Row="2" Background="#121824" Padding="12,6" BorderBrush="#1E2638" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="DevScreenInfo" Foreground="#546E7A" FontSize="11" />
                <TextBlock x:Name="StatusText" Text="就緒" Foreground="#90A4AE" FontSize="11" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
