<UserControl x:Class="PerformanceAnalysis.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1100">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,14"
                Margin="0,0,0,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="裝置管理" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="編輯別名、設定基準，或將場次移到其他裝置／拆分為新裝置。"
                               Style="{StaticResource SecondaryText}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="總覽" Style="{StaticResource GhostButton}" Command="{Binding HomeCommand}" Margin="0,0,8,0" />
                    <Button Content="返回" Style="{StaticResource GhostButton}" Command="{Binding BackCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,12,14,8">
                        <TextBlock Text="裝置" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding Devices.Count, StringFormat=共 {0} 台}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="裝置" Binding="{Binding DisplayName}" Width="200" />
                            <DataGridTextColumn Header="場次" Binding="{Binding SessionCountText}" Width="52" />
                            <DataGridTextColumn Header="基準" Binding="{Binding BaselineText}" Width="56" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="12,0,0,0"
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDeviceHeader}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedDeviceHardware}"
                                       Style="{StaticResource SecondaryText}"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedDeviceBaseline, StringFormat=基準：{0}}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedDevice.SessionCountText, StringFormat={}{0} 場}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding AliasText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource {x:Type TextBox}}"
                                 Tag="輸入裝置別名" />
                        <Button Grid.Column="1"
                                Content="儲存別名"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding SaveAliasCommand}"
                                Margin="8,0,0,0" />
                    </Grid>

                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="設為基準"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding SetBaselineCommand}"
                                Margin="0,0,8,8" />
                        <ComboBox ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedTargetDevice, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Width="180"
                                  Margin="0,0,8,8" />
                        <Button Content="移到裝置"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding MoveSessionCommand}"
                                Margin="0,0,16,8" />
                        <TextBox Text="{Binding NewDeviceName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource {x:Type TextBox}}"
                                 Width="160"
                                 Tag="新裝置名稱"
                                 Margin="0,0,8,8" />
                        <Button Content="拆分為新裝置"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding SplitSessionCommand}"
                                Margin="0,0,0,8" />
                    </WrapPanel>

                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding Sessions}"
                              SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="場次" Binding="{Binding FolderName}" Width="150" />
                            <DataGridTextColumn Header="開始" Binding="{Binding StartTimeText}" Width="112" />
                            <DataGridTextColumn Header="CPU 平均" Binding="{Binding CpuAverageText}" Width="72" />
                            <DataGridTextColumn Header="RAM 平均" Binding="{Binding RamAverageText}" Width="76" />
                            <DataGridTextColumn Header="基準" Binding="{Binding BaselineMarker}" Width="50" />
                            <DataGridTextColumn Header="警告" Binding="{Binding WarningText}" Width="50" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
