<Window x:Class="TRIOV2.ResourceSimulator.SimulatorMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TRIOV2.ResourceSimulator.Controls"
        xmlns:vm="clr-namespace:TRIOV2.ResourceSimulator.ViewModels"
        mc:Ignorable="d"
        Title="TRIO V2 效能資源監控紀錄器"
        Height="860" Width="1240"
        MinHeight="680" MinWidth="1050"
        Background="#121212"
        Foreground="#EEEEEE"
        Topmost="{Binding IsAlwaysOnTop}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:SimulatorViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 深色卡片樣式 -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- 自訂按鈕樣式 -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3D3D3D"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#383838"/>
                    <Setter Property="BorderBrush" Value="#00BCF9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="Cursor" Value="No"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 開始紀錄按鈕 (紅底) -->
        <Style x:Key="RecordStartBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#A82828"/>
            <Setter Property="BorderBrush" Value="#D63030"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C23232"/>
                    <Setter Property="BorderBrush" Value="#FF5555"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 停止紀錄按鈕 -->
        <Style x:Key="RecordStopBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                    <Setter Property="BorderBrush" Value="#777777"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 微軟工作管理員風格表格樣式 -->
        <Style x:Key="TaskGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="RowBackground" Value="#1A1A1A"/>
            <Setter Property="AlternatingRowBackground" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#222222"/>
                        <Setter Property="Foreground" Value="#AAAAAA"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#2A2A2A"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2B4356"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 任務追蹤勾選框樣式 (包含記錄中鎖定之半透明外觀) -->
        <Style x:Key="TaskTrackCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="No"/>
                    <Setter Property="ToolTip" Value="紀錄進行中鎖定變更，請先停止紀錄"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 頂部標題列 -->
            <RowDefinition Height="Auto"/>
            <!-- 主要工作區 (左邊欄 + 右側圖表與清單) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ 頂部標題列 ═══════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📊" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TRIO V2 效能資源監控紀錄器" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="System Performance Monitor &amp; Task Benchmark Session Recorder" FontSize="10" Foreground="#888888"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="📌 視窗置頂" IsChecked="{Binding IsAlwaysOnTop}"
                          Foreground="#AAAAAA" FontSize="11" Margin="0,0,14,0" Cursor="Hand" VerticalAlignment="Center"/>
                <TextBlock Text="Office of William" Foreground="#555555" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════ 主區域：左右佈局 ═══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 左側：即時讀數與量測紀錄面板 -->
                <ColumnDefinition Width="380" MinWidth="340" MaxWidth="440"/>
                <!-- 右側：波形圖與工作管理員行程清單 -->
                <ColumnDefinition Width="*" MinWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════ 左側面板 (ScrollViewer) ═══════════════ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <!-- 卡片一：全系統即時效能 -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="全系統即時效能 (1 Hz 採樣)" Foreground="#00BCF9" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                            <!-- 處理器 CPU 列 -->
                            <Grid Margin="0,3">
                                <TextBlock Text="全系統 CPU 總計" Foreground="#CCCCCC" FontSize="12"/>
                                <TextBlock Text="{Binding TotalCpuText}" Foreground="#00BCF9" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <TextBlock Text="CPU 剩餘可用餘裕" Foreground="#888888" FontSize="12"/>
                                <TextBlock Text="{Binding RemainingCpuText}" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Background="#2A2A2A" Margin="0,6,0,6"/>

                            <!-- 實體記憶體 RAM 列 -->
                            <Grid Margin="0,3">
                                <TextBlock Text="實體記憶體總容量" Foreground="#888888" FontSize="12"/>
                                <TextBlock Text="{Binding TotalMemoryText}" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <TextBlock Text="已使用記憶體" Foreground="#CCCCCC" FontSize="12"/>
                                <TextBlock Text="{Binding UsedMemoryText}" Foreground="#9B59B6" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <TextBlock Text="可用實體記憶體" Foreground="#888888" FontSize="12"/>
                                <TextBlock Text="{Binding AvailableMemoryText}" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <TextBlock Text="記憶體使用率" Foreground="#CCCCCC" FontSize="12"/>
                                <TextBlock Text="{Binding MemoryUsagePercentText}" Foreground="#9B59B6" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片二：基準效能日誌紀錄 (Session Recorder) -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="基準效能日誌紀錄" Foreground="#00BCF9" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RecordingDurationText}" Foreground="#00BCF9" FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 紀錄狀態提示徽章 -->
                            <Border Background="#252525" BorderBrush="#353535" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,8">
                                <TextBlock Text="{Binding RecordingStatusBadge}" Foreground="#DDDDDD" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <!-- 開始與停止按鈕組 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource RecordStartBtn}"
                                        Content="🔴 開始紀錄" Command="{Binding StartRecordingCommand}"
                                        Margin="0,0,4,0" ToolTip="啟動全系統秒級日誌，並對勾選的任務建立獨立資料夾與 CSV"/>

                                <Button Grid.Column="1" Style="{StaticResource RecordStopBtn}"
                                        Content="⏹ 停止紀錄" Command="{Binding StopRecordingCommand}"
                                        Margin="0,0,4,0" ToolTip="停止紀錄並將 CSV 與 ref.txt 寫入硬碟"/>

                                <Button Grid.Column="2" Style="{StaticResource ModernBtn}"
                                        Content="📋 複製摘要" Command="{Binding CopyRecordSummaryCommand}"
                                        ToolTip="複製當次統計數據至剪貼簿並輸出 ref.txt"/>
                            </Grid>

                            <!-- 區間統計讀數小標 -->
                            <TextBlock Text="當前 / 前次量測統計：" Foreground="#888888" FontSize="11" Margin="0,4,0,4"/>

                            <!-- 統計網格表頭 -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="項目" Foreground="#888888" FontSize="10"/>
                                <TextBlock Grid.Column="1" Text="最高 Max" Foreground="#888888" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="最低 Min" Foreground="#888888" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="平均 Avg" Foreground="#888888" FontSize="10" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- CPU 列 -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CPU" Foreground="#00BCF9" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding RecordedCpuMaxText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding RecordedCpuMinText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding RecordedCpuAvgText}" Foreground="#51CF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- RAM 列 -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RAM" Foreground="#9B59B6" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding RecordedMemMaxText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding RecordedMemMinText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding RecordedMemAvgText}" Foreground="#51CF66" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 日誌檔案操作列 -->
                            <Separator Background="#2A2A2A" Margin="0,6,0,6"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LastLogFileName, StringFormat='Log: {0}'}"
                                           Foreground="#888888" FontSize="10" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding LastLogFilePath}"/>
                                <Button Grid.Column="1" Style="{StaticResource ModernBtn}" Content="📄 查看"
                                        Command="{Binding OpenLogFileCommand}" Margin="4,0,4,0" ToolTip="直接開啟 CSV 日誌"
                                        Padding="6,3" FontSize="10"/>
                                <Button Grid.Column="2" Style="{StaticResource ModernBtn}" Content="📂 目錄"
                                        Command="{Binding OpenLogFolderCommand}" ToolTip="開啟 Log 儲存資料夾"
                                        Padding="6,3" FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片三：監控狀態指示列 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="監控運作狀態" Foreground="#888888" FontSize="11" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════ 右側：三等分區域 (CPU 圖表 / RAM 圖表 / 工作管理員清單) ═══════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- 上塊：CPU 波形圖 -->
                    <RowDefinition Height="1*" MinHeight="140"/>
                    <!-- 中塊：記憶體波形圖 -->
                    <RowDefinition Height="1*" MinHeight="140"/>
                    <!-- 下塊：工作管理員行程清單 (滿版延展) -->
                    <RowDefinition Height="2*" MinHeight="260"/>
                </Grid.RowDefinitions>

                <!-- 上塊：處理器波形圖 -->
                <controls:RealtimeChartControl x:Name="CpuChart" Grid.Row="0" Margin="0,0,0,8"
                                               Title="處理器使用率 (CPU %)" ThemeColor="#00BCF9"/>

                <!-- 中塊：實體記憶體波形圖 -->
                <controls:RealtimeChartControl x:Name="MemoryChart" Grid.Row="1" Margin="0,0,0,8"
                                               Title="實體記憶體使用量 (RAM %)" ThemeColor="#9B59B6"/>

                <!-- 下塊：微軟工作管理員風格行程清單 (支援手動輸入/匯入額外 Task Name 監控) -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 頂部搜尋與全選工具列 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 額外自訂/匯入任務列 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 行程 DataGrid -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 第一列：標題、搜尋與全選/刷新控制 -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋 當前帳號行程監視" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedProcessCountText}" Foreground="#00BCF9" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 搜尋文字框 -->
                                <Border Background="#252525" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" Foreground="#777777" FontSize="10" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                        <TextBox Text="{Binding ProcessSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="110" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                                 FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource ModernBtn}" Content="☑ 全選"
                                        Command="{Binding SelectAllProcessesCommand}" Padding="6,2" FontSize="11" Margin="0,0,4,0"
                                        ToolTip="全選目前顯示的所有行程 (紀錄中鎖定)"/>
                                <Button Style="{StaticResource ModernBtn}" Content="☐ 取消"
                                        Command="{Binding DeselectAllProcessesCommand}" Padding="6,2" FontSize="11" Margin="0,0,4,0"
                                        ToolTip="取消所有勾選 (紀錄中鎖定)"/>
                                <Button Style="{StaticResource ModernBtn}" Content="🔄 刷新"
                                        Command="{Binding RefreshProcessesCommand}" Padding="6,2" FontSize="11"
                                        ToolTip="重新掃描當前使用者行程"/>
                            </StackPanel>
                        </Grid>

                        <!-- 第二列：手動新增與檔案匯入/範例下載工具列 -->
                        <Border Grid.Row="1" Background="#162129" BorderBrush="#263E4D" BorderThickness="1" CornerRadius="5" Padding="6,4" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="額外監控:" Foreground="#8AD4F5" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>

                                <!-- 手動輸入框 + 加入按鈕 -->
                                <Grid Grid.Column="1" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#12181E" BorderBrush="#344B5A" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                        <Grid>
                                            <TextBlock Text="輸入 Task Name (逗號分隔可多筆，含尚未執行任務)"
                                                       Foreground="#667B8A" FontSize="11" VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ManualTaskNameInput}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Text="{Binding ManualTaskNameInput, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanChangeProcessSelection}"
                                                     Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" CaretBrush="#00BCF9"
                                                     FontSize="11" VerticalAlignment="Center"
                                                     ToolTip="輸入一個或多個處理程序名稱 (如 TRIOV2.App, notepad)，按下 Enter 或點擊加入">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" Command="{Binding AddManualTaskCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Grid>
                                    </Border>

                                    <Button Grid.Column="1" Style="{StaticResource ModernBtn}" Content="➕ 加入"
                                            Command="{Binding AddManualTaskCommand}" Padding="8,3" FontSize="11"
                                            ToolTip="將輸入的 Task Name 加入額外追蹤清單 (支援多筆逗號分隔)"/>
                                </Grid>

                                <!-- 匯入清單 / 下載範例 / 清除自訂 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ModernBtn}" Content="📥 匯入清單"
                                            Command="{Binding ImportTaskListCommand}" Padding="7,3" FontSize="11" Margin="0,0,4,0"
                                            ToolTip="從 CSV 或 TXT 匯入一到多個要監控的 Task Name (含尚未執行任務)"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="📄 下載範例"
                                            Command="{Binding DownloadSampleTasksCommand}" Padding="7,3" FontSize="11" Margin="0,0,4,0"
                                            ToolTip="下載標準 Task Name 匯入範例檔 (含填入格式說明)"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="🗑 清除自訂"
                                            Command="{Binding ClearCustomTasksCommand}" Padding="7,3" FontSize="11"
                                            ToolTip="移除所有手動輸入與匯入的額外監控任務"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 行程表格 (DataGrid: 支援點選欄位排序、禁止紀錄中勾選、每秒原地更新不閃爍空白) -->
                        <DataGrid Grid.Row="2" Style="{StaticResource TaskGridStyle}"
                                  ItemsSource="{Binding ProcessView}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="True"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <!-- 勾選欄 (作為啟動紀錄追蹤項目，開始紀錄後自動 Disabled 並呈現灰階鎖定效果，停止後恢復 Enabled) -->
                                <DataGridTemplateColumn Header="追蹤" Width="44" SortMemberPath="IsSelected">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource TaskTrackCheckBoxStyle}"
                                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding DataContext.CanChangeProcessSelection, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 名稱 (自訂/匯入目標顯示專屬徽章，可單獨點擊 × 移出) -->
                                <DataGridTemplateColumn Header="名稱" Width="155" SortMemberPath="ProcessName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel VerticalAlignment="Center" LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="✕"
                                                        Command="{Binding DataContext.RemoveCustomTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding ProcessName}"
                                                        Visibility="{Binding IsCustomTarget, Converter={StaticResource BoolToVis}}"
                                                        IsEnabled="{Binding DataContext.CanChangeProcessSelection, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Background="Transparent" Foreground="#888888" BorderThickness="0"
                                                        Padding="4,0" FontSize="10" Cursor="Hand"
                                                        ToolTip="從自訂監控名單中移除此項目"/>
                                                <Border DockPanel.Dock="Left"
                                                        Background="#1B4F6E" BorderBrush="#00BCF9" BorderThickness="1" CornerRadius="3"
                                                        Padding="4,0" Margin="0,0,5,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsCustomTarget, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="自訂" Foreground="#8CE0FF" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"
                                                           VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- PID (數值排序，尚未執行顯示 "—") -->
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessIdText}" Width="52" SortMemberPath="ProcessId">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#888888"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 狀態 (依執行/尚未執行/沒有回應自動著色) -->
                                <DataGridTextColumn Header="狀態" Binding="{Binding StatusText}" Width="72" SortMemberPath="StatusText">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2ECC71"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusText}" Value="尚未執行">
                                                    <Setter Property="Foreground" Value="#FFC107"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="沒有回應">
                                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- CPU (數值排序) -->
                                <DataGridTextColumn Header="CPU" Binding="{Binding CpuPercentText}" Width="70" SortMemberPath="CpuPercent">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#00BCF9"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 記憶體 (數值排序) -->
                                <DataGridTextColumn Header="記憶體" Binding="{Binding MemoryText}" Width="85" SortMemberPath="MemoryMb">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#9B59B6"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 磁碟 (數值排序) -->
                                <DataGridTextColumn Header="磁碟" Binding="{Binding DiskIoText}" Width="85" SortMemberPath="DiskIoKbPerSec">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#CCCCCC"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 網路 (數值排序) -->
                                <DataGridTextColumn Header="網路" Binding="{Binding NetworkText}" Width="75" SortMemberPath="NetworkKbps">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#CCCCCC"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 電源用量 -->
                                <DataGridTextColumn Header="電源用量" Binding="{Binding PowerUsage}" Width="75" SortMemberPath="PowerUsage">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#DDDDDD"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 電源用量趨勢 -->
                                <DataGridTextColumn Header="電源用量趨勢" Binding="{Binding PowerTrend}" Width="85" SortMemberPath="PowerTrend">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#AAAAAA"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
