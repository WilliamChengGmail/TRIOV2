<Window x:Class="PerformanceAnalysis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PerformanceAnalysis.App.ViewModels"
        xmlns:views="clr-namespace:PerformanceAnalysis.App.Views"
        mc:Ignorable="d"
        Title="TRIOV2 效能分析"
        Height="900"
        Width="1440"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionDetailViewModel}">
            <views:SessionDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompareViewModel}">
            <views:CompareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10"
                            Height="10"
                            CornerRadius="5"
                            Background="{StaticResource AccentTealBrush}"
                            Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="TRIOV2 效能分析" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Performance Analysis"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <TextBox Grid.Column="2"
                         Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Logs 資料夾路徑"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ScanCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="匯出 HTML"
                            Style="{StaticResource GhostButton}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            ToolTip="將目前載入的場次匯出為單一 HTML 報告"
                            Command="{Binding ExportHtmlCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="瀏覽"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding BrowseCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="掃描"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding ScanCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="10,18,10,10">
                        <TextBlock Text="導覽"
                                   Style="{StaticResource MutedText}"
                                   Margin="10,0,0,8" />
                        <Button Content="總覽"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding HomeCommand}" />
                        <Button Content="返回"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding BackCommand}" />
                        <Button Content="裝置"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding DevicesCommand}" />
                        <Button Content="比較"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding CompareCommand}" />
                        <Button Content="設定"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding SettingsCommand}" />

                        <Border Height="1"
                                Background="{StaticResource BorderDarkBrush}"
                                Margin="10,10" />

                        <TextBlock Text="v0.5 ・ M5"
                                   Style="{StaticResource MutedText}"
                                   Margin="10,0,0,4" />
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="TRIOV2 效能分析"
                               Style="{StaticResource MutedText}"
                               Margin="14,0,0,14" />
                </Grid>
            </Border>

            <!-- Page -->
            <Grid Grid.Column="1">
                <ContentControl Content="{Binding CurrentPage}" />

                <Border Background="{StaticResource AppBackgroundBrush}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="選擇 Logs 資料夾開始分析"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="支援單一場次、上層多場次，以及 裝置/場次 巢狀結構"
                                   Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="也可以直接把資料夾拖曳到視窗"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                        <Button Content="選擇資料夾"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding BrowseCommand}"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0"
                                Padding="20,9" />
                    </StackPanel>
                </Border>

                <Border Background="#800A1628"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="220" Height="3" />
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding SummaryText}"
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
