<UserControl x:Class="PerformanceAnalysis.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1100">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,16,16,24">

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="分析設定" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="調整異常判定門檻。儲存後會清除解析快取並重新分析目前載入的場次。"
                                   Style="{StaticResource SecondaryText}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="總覽" Style="{StaticResource GhostButton}" Command="{Binding HomeCommand}" Margin="0,0,8,0" />
                        <Button Content="返回" Style="{StaticResource GhostButton}" Command="{Binding BackCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,12,0,0"
                    Padding="16,14">
                <StackPanel>
                    <TextBlock Text="異常門檻" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="數值超出門檻時，會在單場次診斷與 HTML 報告中標示。"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0" />

                    <WrapPanel Margin="0,14,0,0">
                        <StackPanel Width="250" Margin="0,0,16,14">
                            <TextBlock Text="CPU 高負載門檻 (%)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding CpuHighPercentText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Tag="90" />
                            <TextBlock Text="CPU 使用率大於等於此值"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Width="250" Margin="0,0,16,14">
                            <TextBlock Text="CPU 持續秒數" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding CpuHighSustainedSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Tag="10" />
                            <TextBlock Text="連續超過門檻達此秒數才列為異常"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Width="250" Margin="0,0,16,14">
                            <TextBlock Text="記憶體使用率門檻 (%)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding RamHighPercentText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Tag="90" />
                            <TextBlock Text="RAM 使用率大於等於此值"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Width="250" Margin="0,0,16,14">
                            <TextBlock Text="可用記憶體下限 (GB)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding AvailableRamMinimumGbText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Tag="1" />
                            <TextBlock Text="可用 RAM 低於此值時提示"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Width="250" Margin="0,0,16,14">
                            <TextBlock Text="記憶體成長門檻 (MB/min)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding MemoryGrowthMbPerMinuteText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Tag="20" />
                            <TextBlock Text="線性回歸斜率超過此值時提示"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Width="250" Margin="0,0,16,14">
                            <TextBlock Text="記憶體觀察秒數" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding MemoryGrowthMinimumSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Tag="300" />
                            <TextBlock Text="場次長度需達此秒數才判斷成長"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Width="250" Margin="0,0,16,14">
                            <TextBlock Text="短場次門檻 (秒)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding ShortSessionSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Tag="10" />
                            <TextBlock Text="場次短於此秒數時提示"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Width="250" Margin="0,0,16,14">
                            <TextBlock Text="跳秒門檻 (秒)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding SampleGapSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Tag="2" />
                            <TextBlock Text="相鄰樣本間隔超過此值時提示"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Width="250" Margin="0,0,16,14">
                            <TextBlock Text="重複樣本比例門檻 (%)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding DuplicateRatioPercentText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Tag="1" />
                            <TextBlock Text="同一秒重複樣本超過此比例時提示"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Width="250" Margin="0,0,16,14">
                            <TextBlock Text="CPU P95 注意門檻 (%)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding CpuP95AttentionPercentText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Tag="70" />
                            <TextBlock Text="95% 的時間 CPU 都低於此值才算有餘裕；達到時列為「注意」"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Width="250" Margin="0,0,16,14">
                            <TextBlock Text="CPU P95 異常門檻 (%)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding CpuP95ProblemPercentText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Tag="85" />
                            <TextBlock Text="CPU P95 超過此值列為「異常」（與硬體分析器的升級線一致）"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Width="250" Margin="0,0,16,14">
                            <TextBlock Text="任務重啟門檻 (次)" Style="{StaticResource MutedText}" />
                            <TextBox Text="{Binding TaskRestartThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,0"
                                     Tag="3" />
                            <TextBlock Text="同一任務重啟次數超過此值時提示"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,12,0,0"
                    Padding="16,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="解析快取" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="已解析的場次會暫存在記憶體，重新掃描時可直接重用。"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CacheCountText}"
                                   Style="{StaticResource SecondaryText}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="快取只存在記憶體，關閉程式後自動清除；不會影響中繼資料、別名或基準。"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10.5"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Content="清除快取"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ClearCacheCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,12,0,0"
                    Padding="16,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="儲存設定" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="設定會寫入執行檔旁的 Metadata\settings.json。"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource SecondaryText}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="回復預設"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding ResetCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="儲存並重新分析"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
