<UserControl x:Class="PerformanceAnalysis.App.Views.SessionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:PerformanceAnalysis.App.Controls"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <DataTemplate x:Key="DiagnosticItemTemplate">
            <Border Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{Binding SeverityBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Code}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Message}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,16,16,24">

            <!-- Header -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FolderName}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border Background="#1B3A5C"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeviceText}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource AccentTealBrush}" />
                            </Border>
                            <Border Background="#3A2A1A"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding WarningDetailText}"
                                           FontSize="11"
                                           Foreground="{StaticResource WarningYellowBrush}" />
                            </Border>
                            <Border Background="#3A301A"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsBaseline, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="★ 基準場次"
                                           FontSize="11"
                                           Foreground="{StaticResource WarningYellowBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding HardwareText}"
                                   Style="{StaticResource SecondaryText}"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding TimeRangeText}" Style="{StaticResource MutedText}" />
                            <TextBlock Text=" ・ " Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource MutedText}" />
                            <TextBlock Text=" ・ " Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding SampleText, StringFormat=樣本 {0}}" Style="{StaticResource MutedText}" />
                            <TextBlock Text=" ・ " Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding ModeText}" Style="{StaticResource MutedText}" />
                        </StackPanel>

                        <TextBlock Text="{Binding BaselineComparisonText}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="設為基準"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding SetBaselineCommand}"
                                Margin="0,0,8,0"
                                Visibility="{Binding IsNotBaseline, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="開啟資料夾"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding OpenFolderCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="返回"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding BackCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 結論：白話燈號、原因與建議（給非技術讀者） -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{Binding Health.Brush}"
                    BorderThickness="5,1,1,1"
                    CornerRadius="10"
                    Padding="16,12"
                    Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding Health.Brush}"
                                CornerRadius="16"
                                Padding="16,5"
                                MinWidth="84"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Health.LevelText}"
                                       Foreground="{Binding Health.ForegroundBrush}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Health.Headline}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Health.ConfidenceText}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Health.Findings}"
                                  Margin="0,10,0,0"
                                  Visibility="{Binding Health.HasFindings, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,0,0,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border BorderBrush="{Binding Brush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,0"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryText}"
                                                           Foreground="{Binding Brush}"
                                                           FontSize="11" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Explanation}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SuggestionText}"
                                                   Foreground="{StaticResource PrimaryBlueBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding DetailText}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- KPI -->
            <UniformGrid Columns="3" Margin="0,12,0,0">
                <controls:KpiCard Title="CPU 平均"
                                  ToolTip="處理器平均忙碌程度。越高代表電腦越忙；p95＝95% 的時間都低於此值，長時間接近 100% 可能卡頓。"
                                  Value="{Binding CpuAverageText}"
                                  Detail="{Binding CpuDetailText}"
                                  Accent="{StaticResource PrimaryBlueBrush}"
                                  Margin="0,0,8,8" />
                <controls:KpiCard Title="RAM 平均"
                                  ToolTip="程式執行占用的記憶體（GB）。使用率接近 100% 時系統會變慢。"
                                  Value="{Binding RamAverageText}"
                                  Detail="{Binding RamDetailText}"
                                  Accent="{StaticResource PurpleBrush}"
                                  Margin="0,0,8,8" />
                <controls:KpiCard Title="磁碟峰值"
                                  ToolTip="受監測程式讀寫硬碟的最高速度。"
                                  Value="{Binding DiskPeakText}"
                                  Detail="{Binding DiskDetailText}"
                                  Accent="{StaticResource AccentTealBrush}"
                                  Margin="0,0,0,8" />
                <controls:KpiCard Title="網路峰值"
                                  ToolTip="受監測程式網路傳輸的最高速度。"
                                  Value="{Binding NetworkPeakText}"
                                  Detail="{Binding NetworkDetailText}"
                                  Accent="{StaticResource SuccessGreenBrush}"
                                  Margin="0,0,8,0" />
                <controls:KpiCard Title="辨識時長"
                                  ToolTip="每次影像辨識所花的時間，越短越好。"
                                  Value="{Binding RecognitionText}"
                                  Detail="{Binding RecognitionDetailText}"
                                  Accent="{StaticResource WarningYellowBrush}"
                                  Margin="0,0,8,0" />
                <controls:KpiCard Title="資料完整率"
                                  ToolTip="實際記錄到的秒數 ÷ 應記錄的秒數。低於 100% 代表中途有漏記。"
                                  Value="{Binding CompletenessText}"
                                  Detail="{Binding CompletenessDetailText}"
                                  Accent="{StaticResource PrimaryBlueBrush}" />
            </UniformGrid>

            <!-- System charts -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,6,0"
                        Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="系統 CPU" Style="{StaticResource SectionTitle}" />
                        <sp:WpfPlot x:Name="CpuPlot" Grid.Row="1" Height="220" Margin="0,6,0,0" PreviewMouseWheel="Chart_PreviewMouseWheel" />
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="6,0,0,0"
                        Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="系統記憶體" Style="{StaticResource SectionTitle}" />
                        <sp:WpfPlot x:Name="MemoryPlot" Grid.Row="1" Height="220" Margin="0,6,0,0" PreviewMouseWheel="Chart_PreviewMouseWheel" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Gantt -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,12,0,0"
                    Padding="14,10">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="任務執行時間軸" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="每一列為一個任務；空白表示未執行"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <controls:TaskGantt Rows="{Binding GanttRows}"
                                        SessionStart="{Binding Session.StartTime}"
                                        SessionEnd="{Binding Session.EndTime}"
                                        Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Task charts -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,6,0"
                        Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="任務 CPU" Style="{StaticResource SectionTitle}" />
                        <sp:WpfPlot x:Name="TaskCpuPlot" Grid.Row="1" Height="220" Margin="0,6,0,0" PreviewMouseWheel="Chart_PreviewMouseWheel" />
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="6,0,0,0"
                        Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="任務記憶體" Style="{StaticResource SectionTitle}" />
                        <sp:WpfPlot x:Name="TaskMemoryPlot" Grid.Row="1" Height="220" Margin="0,6,0,0" PreviewMouseWheel="Chart_PreviewMouseWheel" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Task table -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="14,12,14,8">
                        <TextBlock Text="任務統計" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding TaskCountText, StringFormat=共 {0} 個任務}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding TaskRows}"
                              MaxHeight="320"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="22">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="8"
                                                Height="8"
                                                CornerRadius="4"
                                                Background="{Binding Brush}"
                                                VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="任務" Binding="{Binding Name}" Width="220" />
                            <DataGridTextColumn Header="狀態" Binding="{Binding StatusText}" Width="66" />
                            <DataGridTextColumn Header="執行時間" Binding="{Binding ActiveText}" Width="76" />
                            <DataGridTextColumn Header="執行率" Binding="{Binding ActiveRatioText}" Width="62" />
                            <DataGridTextColumn Header="CPU 平均/最高" Binding="{Binding CpuText}" Width="105" />
                            <DataGridTextColumn Header="記憶體 平均/最高 MB" Binding="{Binding MemoryText}" Width="130" />
                            <DataGridTextColumn Header="磁碟峰值" Binding="{Binding DiskText}" Width="90" />
                            <DataGridTextColumn Header="網路峰值" Binding="{Binding NetworkText}" Width="90" />
                            <DataGridTextColumn Header="區間/重啟" Binding="{Binding RunsText}" Width="78" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1"
                               Text="沒有任務紀錄"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,24"
                               Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <!-- Annotations -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,12,0,0"
                    Padding="14,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="備註與標籤" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding AnnotationStatus}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="備註"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     Height="62"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Tag="輸入備註"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                            <TextBlock Text="標籤（逗號分隔）"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding LabelsText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="62"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Tag="標籤，以逗號分隔"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="儲存"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding SaveAnnotationsCommand}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,2" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,12,0,0"
                    Padding="14,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="診斷與資料品質" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding WarningDetailText}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Diagnostics}"
                                  ItemTemplate="{StaticResource DiagnosticItemTemplate}"
                                  Margin="0,10,0,0" />

                    <TextBlock Text="沒有警告或錯誤"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0"
                               Visibility="{Binding HasNoDiagnostics, Converter={StaticResource BoolToVisibility}}" />

                    <Expander Header="{Binding InfoDiagnosticsHeader}"
                              IsExpanded="False"
                              Margin="0,6,0,0"
                              Visibility="{Binding HasInfoDiagnostics, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding InfoDiagnostics}"
                                      ItemTemplate="{StaticResource DiagnosticItemTemplate}"
                                      Margin="0,6,0,0" />
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Raw data -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,12,0,0"
                    Padding="14,8">
                <Expander Header="{Binding RawDataHeader}" IsExpanded="False">
                    <DataGrid ItemsSource="{Binding SystemRows}"
                              Height="320"
                              Margin="0,8,0,0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="時間" Binding="{Binding TimestampText}" Width="120" />
                            <DataGridTextColumn Header="全系統 CPU" Binding="{Binding CpuTotalText}" Width="86" />
                            <DataGridTextColumn Header="模擬器 CPU" Binding="{Binding CpuSimulatorText}" Width="86" />
                            <DataGridTextColumn Header="空閒 CPU" Binding="{Binding CpuFreeText}" Width="76" />
                            <DataGridTextColumn Header="已用 RAM" Binding="{Binding MemoryUsedText}" Width="76" />
                            <DataGridTextColumn Header="可用 RAM" Binding="{Binding MemoryAvailableText}" Width="76" />
                            <DataGridTextColumn Header="RAM %" Binding="{Binding MemoryPercentText}" Width="60" />
                            <DataGridTextColumn Header="影像緩衝" Binding="{Binding FrameBufferText}" Width="76" />
                            <DataGridTextColumn Header="辨識狀態" Binding="{Binding RecognitionState}" Width="92" />
                            <DataGridTextColumn Header="辨識 ms" Binding="{Binding RecognitionMsText}" Width="72" />
                            <DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
