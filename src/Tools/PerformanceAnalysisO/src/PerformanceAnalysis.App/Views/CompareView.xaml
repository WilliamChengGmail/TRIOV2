<UserControl x:Class="PerformanceAnalysis.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1100">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,14"
                Margin="0,0,0,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="場次比較" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="勾選 2 場以上，比較 CPU、RAM、磁碟、網路與辨識表現；Δ 為與同裝置基準的差異。"
                               Style="{StaticResource SecondaryText}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="{Binding SelectedCountText}"
                               Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBlock Text="基準"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding BaselineCandidates}"
                              SelectedItem="{Binding SelectedBaseline, Mode=TwoWay}"
                              DisplayMemberPath="DisplayText"
                              Width="250"
                              Margin="0,0,12,0" />
                    <Button Content="全選" Style="{StaticResource GhostButton}" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
                    <Button Content="清除" Style="{StaticResource GhostButton}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
                    <Button Content="返回" Style="{StaticResource GhostButton}" Command="{Binding BackCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,12,14,8">
                        <TextBlock Text="選擇場次" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="勾選要比較的場次"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Sessions}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="比較" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="場次" Binding="{Binding FolderName}" Width="150" />
                            <DataGridTextColumn Header="裝置" Binding="{Binding DeviceDisplay}" Width="140" />
                            <DataGridTextColumn Header="基準" Binding="{Binding BaselineMarker}" Width="44" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,12,14,8">
                        <TextBlock Text="比較結果" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding BaselineSummaryText}"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Rows}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="場次" Binding="{Binding FolderName}" Width="140" />
                            <DataGridTextColumn Header="裝置" Binding="{Binding DeviceDisplay}" Width="140" />
                            <DataGridTextColumn Header="開始" Binding="{Binding StartTimeText}" Width="108" />
                            <DataGridTextColumn Header="CPU 平均" Binding="{Binding CpuAverageText}" Width="72" />
                            <DataGridTemplateColumn Header="ΔCPU" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CpuDeltaText}" Foreground="{Binding CpuDeltaBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="CPU 最高" Binding="{Binding CpuMaxText}" Width="72" />
                            <DataGridTextColumn Header="RAM 平均" Binding="{Binding RamAverageText}" Width="78" />
                            <DataGridTemplateColumn Header="ΔRAM" Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RamDeltaText}" Foreground="{Binding RamDeltaBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="RAM 最高" Binding="{Binding RamMaxText}" Width="78" />
                            <DataGridTextColumn Header="磁碟峰值" Binding="{Binding DiskPeakText}" Width="92" />
                            <DataGridTextColumn Header="網路峰值" Binding="{Binding NetworkPeakText}" Width="92" />
                            <DataGridTextColumn Header="辨識" Binding="{Binding RecognitionText}" Width="72" />
                            <DataGridTemplateColumn Header="Δ辨識" Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RecognitionDeltaText}" Foreground="{Binding RecognitionDeltaBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="完整率" Binding="{Binding CompletenessText}" Width="68" />
                            <DataGridTextColumn Header="警告" Binding="{Binding WarningText}" Width="50" />
                            <DataGridTextColumn Header="基準" Binding="{Binding CompareBaselineMarker}" Width="44" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1"
                               Text="請從左側勾選至少一場"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
