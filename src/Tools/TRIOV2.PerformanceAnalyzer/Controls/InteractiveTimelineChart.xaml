<UserControl x:Class="TRIOV2.PerformanceAnalyzer.Controls.InteractiveTimelineChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#141414"
             SnapsToDevicePixels="True">
    <Grid>
        <Canvas x:Name="PlotCanvas"
                ClipToBounds="True"
                Background="Transparent"
                MouseMove="PlotCanvas_MouseMove"
                MouseLeave="PlotCanvas_MouseLeave"
                MouseLeftButtonDown="PlotCanvas_MouseLeftButtonDown"
                MouseLeftButtonUp="PlotCanvas_MouseLeftButtonUp"/>

        <!-- 滑鼠 Hover 詳細讀值浮動卡片 -->
        <Border x:Name="TooltipCard"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,14,0"
                Padding="10,7"
                CornerRadius="6"
                Background="#E61A1A1A"
                BorderBrush="#3F3F46"
                BorderThickness="1">
            <TextBlock x:Name="TooltipText"
                       FontFamily="Consolas, Microsoft JhengHei"
                       FontSize="12"
                       Foreground="#F4F4F5"/>
        </Border>
    </Grid>
</UserControl>

